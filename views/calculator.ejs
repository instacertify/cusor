<%- include('partials/head') %>
<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a> / Cost Calculator</div>
    <h1><%= pageRow.title %></h1>
    <p class="muted"><%= pageRow.subtitle %></p>
  </div>
</div>
<section class="section">
  <div class="container detail-grid">
    <div>
      <div class="form-card">
        <form id="calcForm">
          <div class="field">
            <label for="calcProduct">Select your product</label>
            <select id="calcProduct" required>
              <option value="">— Choose a product —</option>
              <% products.forEach(function(p){ %>
                <option value="<%= p.slug %>"
                  data-name="<%= p.name %>"
                  data-scheme="<%= p.scheme %>"
                  data-cost="<%= formatCost(p.cost_min) %>–<%= formatCost(p.cost_max) %>"
                  data-timeline="<%= p.timeline %>"><%= p.name %></option>
              <% }); %>
            </select>
          </div>
          <button class="btn btn-primary btn-block" type="submit">Estimate Cost</button>
        </form>
        <div id="calcResult" class="result-box" style="display:none;margin-top:22px;">
          <h3 id="resName"></h3>
          <div class="fact-row" style="border-color:rgba(255,255,255,.2)"><span class="k" style="color:rgba(255,255,255,.7)">Scheme</span><span class="v" style="color:#fff" id="resScheme"></span></div>
          <div style="margin:14px 0"><div style="color:rgba(255,255,255,.7);font-size:.85rem">Estimated all-in cost</div><div class="big" id="resCost"></div></div>
          <div style="color:rgba(255,255,255,.7);font-size:.85rem">Typical timeline: <span id="resTime" style="color:#fff;font-weight:700"></span></div>
          <a class="btn btn-cta btn-block" style="margin-top:16px" href="/contact">Get an exact quote</a>
        </div>
      </div>
    </div>
    <aside>
      <div class="prose"><%- pageRow.body_html %></div>
    </aside>
  </div>
</section>
<%- include('partials/footer') %>
