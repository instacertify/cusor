<%- include('partials/head') %>
<div class="topbar"><h1><%= isNew ? 'New' : 'Edit' %> Category</h1><a class="btn btn-light" href="/admin/categories">← Back</a></div>
<div class="panel">
  <form action="<%= isNew ? '/admin/categories' : '/admin/categories/' + category.id %>" method="post" enctype="multipart/form-data">
    <div class="row-3">
      <div class="field"><label>Name</label><input type="text" name="name" value="<%= category.name || '' %>" required /></div>
      <div class="field"><label>Icon (emoji)</label><input type="text" name="icon" value="<%= category.icon || '' %>" /></div>
      <div class="field"><label>Sort order</label><input type="number" name="sort_order" value="<%= category.sort_order || 0 %>" /></div>
    </div>
    <div class="field"><label>Slug (optional)</label><input type="text" name="slug" value="<%= category.slug || '' %>" /></div>
    <div class="field"><label>Description</label><textarea name="description" rows="2"><%= category.description || '' %></textarea></div>
    <div class="field"><label>Content (HTML, optional)</label><textarea name="content" rows="6"><%= category.content || '' %></textarea></div>
    <div class="row">
      <div class="field"><label>Image URL</label><input type="text" name="image" value="<%= category.image || '' %>" /></div>
      <div class="field"><label>Or upload image</label><input type="file" name="image_file" accept="image/*" /></div>
    </div>
    <button class="btn btn-primary" type="submit">Save Category</button>
  </form>
</div>
<%- include('partials/foot') %>
