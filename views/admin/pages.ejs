<%- include('partials/head') %>
<div class="topbar"><h1>Content Pages</h1><a class="btn btn-primary" href="/admin/pages/new">+ New Page</a></div>
<table>
  <tr><th>Title</th><th>Slug / URL</th><th>Actions</th></tr>
  <% pages.forEach(function(p){ %>
    <tr>
      <td><strong><%= p.title %></strong><br><span style="color:var(--muted);font-size:.8rem"><%= p.subtitle %></span></td>
      <td><a href="/page/<%= p.slug %>" target="_blank">/page/<%= p.slug %></a></td>
      <td class="actions">
        <a class="btn btn-light btn-sm" href="/admin/pages/<%= p.id %>/edit">Edit</a>
        <form action="/admin/pages/<%= p.id %>/delete" method="post" onsubmit="return confirm('Delete page?')"><button class="btn btn-danger btn-sm" type="submit">Delete</button></form>
      </td>
    </tr>
  <% }); %>
</table>
<%- include('partials/foot') %>
