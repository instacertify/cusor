<%- include('partials/head') %>
<div class="topbar"><h1>Categories</h1><a class="btn btn-primary" href="/admin/categories/new">+ New Category</a></div>
<table>
  <tr><th>Icon</th><th>Name</th><th>Description</th><th>Order</th><th>Actions</th></tr>
  <% categories.forEach(function(c){ %>
    <tr>
      <td style="font-size:1.4rem"><%= c.icon %></td>
      <td><strong><%= c.name %></strong><br><span style="color:var(--muted);font-size:.8rem">/<%= c.slug %></span></td>
      <td style="max-width:360px;color:var(--muted)"><%= c.description %></td>
      <td><%= c.sort_order %></td>
      <td class="actions">
        <a class="btn btn-light btn-sm" href="/admin/categories/<%= c.id %>/edit">Edit</a>
        <form action="/admin/categories/<%= c.id %>/delete" method="post" onsubmit="return confirm('Delete category?')"><button class="btn btn-danger btn-sm" type="submit">Delete</button></form>
      </td>
    </tr>
  <% }); %>
</table>
<%- include('partials/foot') %>
