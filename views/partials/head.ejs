<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : (settings.tagline || '') %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="stylesheet" href="/css/styles.css" />
  <style>:root{--navy:<%= settings.brand_primary || '#1d2b50' %>;--amber:<%= settings.brand_accent || '#f5b93f' %>;}</style>
</head>
<body>
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">
      <span class="logo-mark">C</span>
      <span><%= settings.site_name || 'Certko' %></span>
    </a>
    <ul class="nav-links" id="navLinks">
      <li><a href="/products" class="<%= page === 'products' ? 'active' : '' %>">Products</a></li>
      <li><a href="/categories" class="<%= page === 'categories' ? 'active' : '' %>">Categories</a></li>
      <li><a href="/page/guide" class="<%= page === 'guide' ? 'active' : '' %>">Guide</a></li>
      <li><a href="/cost-calculator" class="<%= page === 'calculator' ? 'active' : '' %>">Cost Calculator</a></li>
      <li><a href="/faq" class="<%= page === 'faq' ? 'active' : '' %>">FAQ</a></li>
    </ul>
    <div class="nav-cta">
      <a class="btn btn-primary" href="/contact">Get Expert Help</a>
      <button class="menu-toggle" id="menuToggle" aria-label="Menu">&#9776;</button>
    </div>
  </div>
</header>
<main>
